{
  "name": "react-kavia",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=18.x",
    "npm": ">=8.x"
  },
  "packageManager": "npm@9",
  "overrides": {
    "ajv": "6.12.6",
    "ajv-keywords": "3.5.2",
    "schema-utils": "2.6.5",
    "terser-webpack-plugin": {
      "schema-utils": "3.3.0",
      "ajv": "6.12.6",
      "ajv-keywords": "3.5.2"
    },
    "webpack": {
      "terser-webpack-plugin": "5.3.10",
      "schema-utils": "3.3.0"
    },
    "webpack-cli": {
      "schema-utils": "3.3.0"
    },
    "webpack-dev-server": {
      "schema-utils": "3.3.0"
    },
    "css-minimizer-webpack-plugin": {
      "schema-utils": "3.3.0"
    },
    "mini-css-extract-plugin": {
      "schema-utils": "3.3.0"
    },
    "eslint-webpack-plugin": {
      "schema-utils": "3.3.0"
    },
    "webpack-dev-middleware": {
      "schema-utils": "3.3.0"
    },
    "@pmmmwh/react-refresh-webpack-plugin": {
      "schema-utils": "3.3.0",
      ".": "0.5.7"
    },
    "babel-loader": "8.2.2",
    "css-loader": {
      "schema-utils": "3.3.0"
    },
    "postcss-loader": {
      "schema-utils": "3.3.0"
    },
    "resolve-url-loader": {
      "schema-utils": "3.3.0"
    },
    "sass-loader": {
      "schema-utils": "3.3.0"
    },
    "@svgr/webpack": {
      "schema-utils": "3.3.0"
    },
    "file-loader": {
      "schema-utils": "3.3.0"
    }
  },
  "dependencies": {
    "ajv": "6.12.6",
    "ajv-keywords": "3.5.2",
    "axios": "^1.6.8",
    "chart.js": "^4.4.1",
    "jwt-decode": "^4.0.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.4",
    "react-router-dom": "^6.22.3",
    "react-scripts": "^5.0.1",
    "recharts": "^2.10.3"
  },
  "scripts": {
    "prepare": "node scripts/patch-lock.js || true",
    "postinstall": "npm i ajv@6.12.6 ajv-keywords@3.5.2 schema-utils@2.6.5 terser-webpack-plugin@5.3.10 --no-audit --no-fund --legacy-peer-deps || true && node scripts/patch-refresh-plugin.js || true && node scripts/check-versions-log.js || true",
    "prebuild": "node scripts/scan-validate-options.js && node scripts/patch-refresh-plugin.js && node -e \"const fs=require('fs'); const {execSync}=require('child_process'); if(!fs.existsSync('node_modules')){console.log('Installing deps before build...'); process.env.CI='true'; try{execSync('npm ci --legacy-peer-deps', {stdio:'inherit'});}catch(e){execSync('npm install --legacy-peer-deps', {stdio:'inherit'});} }\" && node scripts/check-versions-log.js",
    "check:tooling": "node scripts/check-tooling.js",
    "build:trace": "cross-env NODE_ENV=production NODE_OPTIONS=\"--require=./scripts/preload-disable-refresh.js --trace-uncaught --openssl-legacy-provider\" node node_modules/react-scripts/scripts/build.js",
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
    "start:https": "HTTPS=true react-scripts start",
    "build": "cross-env NODE_ENV=production NODE_OPTIONS=\"--require=./scripts/preload-disable-refresh.js --openssl-legacy-provider\" react-scripts build",
    "test": "cross-env CI=true react-scripts test --watchAll=false",
    "lint": "eslint --ext .js,.jsx src",
    "eject": "react-scripts eject",
    "serve:prod": "npx serve -s build -l 3000",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:e2e": "start-server-and-test start http://localhost:3000 cy:run"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/cypress": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "cross-env": "^7.0.3",
    "cypress": "^13.7.3",
    "start-server-and-test": "^2.0.7"
  }
}
