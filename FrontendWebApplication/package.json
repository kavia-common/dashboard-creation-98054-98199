{
  "name": "react-kavia",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=18.x",
    "npm": ">=8.x"
  },
  "packageManager": "npm@9",
  "overrides": {
    "ajv": "^6.12.6",
    "ajv-keywords": "^3.5.2"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "chart.js": "^4.4.1",
    "jwt-decode": "^4.0.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.4",
    "react-router-dom": "^6.22.3",
    "react-scripts": "^5.0.1",
    "recharts": "^2.10.3"
  },
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs'); if(!fs.existsSync('node_modules/react-scripts')){console.log('Installing deps before build...'); process.env.CI='true'; const {execSync}=require('child_process'); try{execSync('npm ci --legacy-peer-deps', {stdio:'inherit'});}catch(e){execSync('npm install --legacy-peer-deps', {stdio:'inherit'});} }\"",
    "start": "react-scripts start",
    "start:https": "HTTPS=true react-scripts start",
    "build": "react-scripts build",
    "test": "cross-env CI=true react-scripts test --watchAll=false",
    "lint": "eslint --ext .js,.jsx src",
    "eject": "react-scripts eject",
    "serve:prod": "npx serve -s build -l 3000",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:e2e": "start-server-and-test start http://localhost:3000 cy:run"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/cypress": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "ajv": "^6.12.6",
    "ajv-keywords": "^3.5.2",
    "cross-env": "^7.0.3",
    "cypress": "^13.7.3",
    "start-server-and-test": "^2.0.7"
  }
}
