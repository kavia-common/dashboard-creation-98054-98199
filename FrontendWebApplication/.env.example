# FrontendWebApplication environment variables

# Backend API base URL (ensure CORS is allowed on backend)
REACT_APP_API_BASE_URL=http://localhost:8000

# Public site URL (used for redirects/emails if applicable)
REACT_APP_SITE_URL=http://localhost:3000

# Default theme: 'light' or 'dark'
REACT_APP_DEFAULT_THEME=light

# OpenSSL legacy provider workaround (fallback for local dev on Node >=17)
# The package.json start script already sets this via NODE_OPTIONS, but keeping
# this here helps when starting the dev server using alternative tools or IDEs.
NODE_OPTIONS=--openssl-legacy-provider
