# Public envs used by Create React App must be prefixed with REACT_APP_

# Backend API base URL (e.g. http://localhost:8000 or http://backend:8000 inside Compose)
REACT_APP_API_BASE_URL=http://localhost:8000

# Site URL used for auth redirects (if needed)
REACT_APP_SITE_URL=http://localhost:3000

# Optional: default theme
REACT_APP_DEFAULT_THEME=light
