# PUBLIC_INTERFACE
# Frontend Environment Variables
# Copy this file to `.env` and adjust values as needed.

# Base URL for the backend API (must include protocol and port)
# Example for local FastAPI: http://localhost:8000
REACT_APP_API_BASE_URL=http://localhost:8000

# Site URL used for redirects/emails in some auth flows (placeholder for future use)
# Set to the public URL of your frontend when deployed.
REACT_APP_SITE_URL=http://localhost:3000

# Default theme: "light" or "dark"
REACT_APP_DEFAULT_THEME=light
