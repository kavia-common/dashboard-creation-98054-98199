# PUBLIC_INTERFACE
# Copy this file to .env and fill the values. Do not commit your real secrets.
# Frontend React (.env.*) variables must be prefixed with REACT_APP_ to be exposed to the app.

# Base URL to the backend API. Default fallback is http://localhost:8000 if not provided.
REACT_APP_API_BASE_URL=http://localhost:8000

# The site URL used for redirects in auth flows (if applicable). Example: http://localhost:3000
REACT_APP_SITE_URL=http://localhost:3000

# Default theme: "light" or "dark"
REACT_APP_DEFAULT_THEME=dark
